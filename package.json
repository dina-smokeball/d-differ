{
  "name": "d-differ",
  "displayName": "Branch Diff",
  "description": "Show diff between the current branch and a base branch",
  "version": "0.0.1",
  "publisher": "d-pod",
  "repository": {
    "type": "git",
    "url": "https://github.com/dina-smokeball/d-differ.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "showDiff",
          "title": "Branch Diff",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "showDiff": [
        {
          "id": "showDiff.changedFiles",
          "name": "Changed Files"
        }
      ]
    },
    "commands": [
      {
        "command": "showDiff.refresh",
        "title": "Refresh",
        "category": "Branch Diff",
        "icon": "$(refresh)"
      },
      {
        "command": "showDiff.pickBaseBranch",
        "title": "Change Base Branch",
        "category": "Branch Diff",
        "icon": "$(git-branch)"
      },
      {
        "command": "showDiff.toggleTestFiles",
        "title": "Toggle Test Files",
        "category": "Branch Diff",
        "icon": "$(eye)"
      },
      {
        "command": "showDiff.toggleReviews",
        "title": "Toggle File Reviews",
        "category": "Branch Diff",
        "icon": "$(book)"
      },
      {
        "command": "showDiff.openDiff",
        "title": "Open Diff",
        "category": "Branch Diff"
      },
      {
        "command": "showDiff.markViewed",
        "title": "Mark as Viewed",
        "category": "Branch Diff",
        "icon": "$(check)"
      },
      {
        "command": "showDiff.markNotViewed",
        "title": "Mark as Not Viewed",
        "category": "Branch Diff",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "showDiff.markViewed",
          "when": "view == showDiff.changedFiles && viewItem =~ /^file-(unviewed|stale)$/",
          "group": "inline@1"
        },
        {
          "command": "showDiff.markNotViewed",
          "when": "view == showDiff.changedFiles && viewItem == file-viewed",
          "group": "inline@1"
        },
        {
          "command": "showDiff.markViewed",
          "when": "view == showDiff.changedFiles && viewItem =~ /^file-(unviewed|stale)$/",
          "group": "1_viewed@1"
        },
        {
          "command": "showDiff.markNotViewed",
          "when": "view == showDiff.changedFiles && viewItem == file-viewed",
          "group": "1_viewed@1"
        }
      ],
      "view/title": [
        {
          "command": "showDiff.pickBaseBranch",
          "when": "view == showDiff.changedFiles",
          "group": "navigation@1"
        },
        {
          "command": "showDiff.toggleTestFiles",
          "when": "view == showDiff.changedFiles",
          "group": "navigation@2"
        },
        {
          "command": "showDiff.toggleReviews",
          "when": "view == showDiff.changedFiles",
          "group": "navigation@3"
        },
        {
          "command": "showDiff.refresh",
          "when": "view == showDiff.changedFiles",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Branch Diff",
      "properties": {
        "showDiff.hideTestFiles": {
          "type": "boolean",
          "default": false,
          "description": "Hide test/spec files and lockfiles from the changed files list."
        },
        "showDiff.showReviews": {
          "type": "boolean",
          "default": true,
          "description": "When opening a file's diff, also open its AI review (if one exists under .local/reviews) beside it."
        },
        "showDiff.testFilePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.spec.*",
            "**/*.test.*",
            "**/__tests__/**",
            "**/__mocks__/**",
            "**/package-lock.json"
          ],
          "description": "Glob patterns for files treated as tests/lockfiles (hidden when showDiff.hideTestFiles is true)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
